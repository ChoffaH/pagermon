<div class="row justify-content-center">
  <div class="col-sm-10">  
    <form class="form-inline" ng-submit="updateFilter('query', query)">
      <div class="input-group">
        <input type="text" class="form-control" placeholder="Search" ng-model="query">
        <button type="submit" class="btn btn-primary" ng-disabled="!query" ng-class="{disabledLink: !query}">
          <i class="fa fa-fw fa-search"></i>
        </button>
        <button type="button" ng-disabled="!query" ng-click="updateFilter('query')" class="btn btn-primary" ng-class="{disabledLink: !query}" ng-disabled="!query">
          <i class="fa fa-fw fa-times"></i>
        </button>
      </div>
    </div>
  </form>
</div>