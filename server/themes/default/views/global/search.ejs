<div class="row justify-content-center">
  <div class="col-sm-10">  
    <form action="/" method="get">
      <div class="input-group">
        <input type="text" id="query" class="form-control" name="q" placeholder="Search" ng-model="query">
        <button type="submit" class="btn btn-primary" ng-disabled="!query" ng-class="{disabledLink: !query}">
          <i class="fa fa-fw fa-search"></i>
        </button>
        <button type="button" ng-disabled="!query" ng-click="clearSearch()" class="btn btn-primary" ng-class="{disabledLink: !query}" ng-disabled="!query">
          <i class="fa fa-fw fa-times"></i>
        </button>
      </div>
    </div>
  </form>
</div>