<!DOCTYPE html>
<html ng-app=app lang="en">
  <head>
    <%- include ('global/header') -%>

    <!-- Inlined and minified below <script src="/javascripts/angular-textreplace.js"></script>-->
    <script>angular.module("angular-highlight",[]).directive("highlight",function(){return{link:function(e,t,h){h.highlightClass||(h.highlightClass="angular-highlight");var l=function(t,l){var a=function(e,t){for(var h=0;h<t.length;h++){var l=new RegExp(t[h].match,"gi");if(e.search(l)>-1)return t[h]}}(t,e.replacement);if("replace"==a.highlight)var r=new RegExp(a.match),i=t.replace(r,a.replace);else i=a.highlight?'<a href="/?q='+t+'" data-toggle="popover" class="'+h.highlightClass+'" title="'+a.replace+'" onmouseenter="$(this).tooltip(\'show\')">'+t+"</a>":'<a href="/?q='+t+'" data-toggle="popover" title="'+a.replace+'" onmouseenter="$(this).tooltip(\'show\')">'+t+"</a>";return i};e.$watch("replacement",function(){if(!e.replacement||""==e.replacement)return t.html(e.highlight),!1;var h=function(e){var t,h=e.length,l=[];for(t=0;t<h;t++)l.push(e[t].match.replace(new RegExp("^ | $","g"),""));return l}(e.replacement),a=new RegExp(h.join("|"),"gmi"),r=e.highlight.replace(a,l);t.html(r)})},replace:!1,scope:{highlight:"=",replacement:"="}}});</script>

    <script>
      const role = "<%=user.role%>";
      const apisecurity = <%=apisecurity%>;
      const hidecapcode = <%=hidecapcode%>;
      const login = <%=login%>;
      const pdwmode = <%=pdwmode%>;
    </script>
    <script src="/javascripts/index.main.js"></script>

    <base href="/">
  </head>

  <body id="home-body" ng-class="{'navbar-up': menu.navbarUp}">
    <%- include ('global/menu.ejs') -%>

    <main class="container-fluid" ng-cloak>
      <ng-view></ng-view>

      <!-- Template -->
      <script type="text/ng-template" id="/messages.html">
        <div ng-show="loading" class="loading">
          <i class="fa fa-spinner fa-spin"></i>
        </div>

        <div class="row">
          <% if (searchLocation === 'top') { %>
            <%- include ('global/search') -%>
          <% } %>
          <table class="table table-sm table-hover table-striped">
            <thead>
              <tr>
                <th colspan="2">
                  <div class="btn-group btn-group-sm mb-1" role="group">
                    <button type="button" class="btn btn-secondary" ng-click="updateData();" aria-label="Refresh" title="Refresh Messages">
                      <i class="fa fa-refresh {{loading ? 'fa-spin' : ''}}" aria-hidden="true"></i>
                    </button>
                    <button type="button" ng-if="notificationSupport == true" class="btn btn-secondary" ng-class="{active: notificationEnabled == 'true'}" ng-click="toggleNotifications();" aria-label="Notifications" title="Toggle Browser Notifications">
                        <i class="fa fa-bell" aria-hidden="true"></i>
                    </button>

                    <div class="btn-group btn-group-sm" role="group">
                      <button type="button" id="messageLimitDrop" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Message Limit" aria-expanded="false">
                        {{init.limit}}
                      </button>
                      <ul class="dropdown-menu" aria-labelledby="messageLimitDrop">
                        <li>
                          <a href="#" ng-class="{disabled:init.limit == 10}" class="dropdown-item" ng-click="setCookie('messageLimit', 10);">10</a>
                        </li>
                        <li>
                          <a href="#" ng-class="{disabled:init.limit == 20}" class="dropdown-item" ng-click="setCookie('messageLimit', 20);">20</a>
                        </li>
                        <li>
                          <a href="#" ng-class="{disabled:init.limit == 50}" class="dropdown-item" ng-click="setCookie('messageLimit', 50);">50</a>
                        </li>
                        <li>
                          <a href="#" ng-class="{disabled:init.limit == 100}" class="dropdown-item" ng-click="setCookie('messageLimit', 100);">100</a>
                        </li>
                      </ul>
                    </div>
                  </div>
                </th>
                <% if (!hidesource || (login && role == 'admin')) { %>
                  <th class="align-middle text-secondary d-none d-md-table-cell">Src</th>
                <% } %>
                <% if (!hidecapcode || (login && role == 'admin')) { %>
                  <th class="align-middle text-secondary d-none d-md-table-cell">Capcode</th>
                <% } %>
                <th class="align-middle text-secondary"></th>
                <th class="align-middle text-secondary d-none d-md-table-cell"></th>
                <th class="align-middle text-secondary">
                  Message
                  <span ng-if="filter || hasQuery" class="border-start p-1">
                      <strong>Filter:</strong> 
                      <a ng-href="/" class="btn btn-primary btn-sm mb-1">
                        {{filter || origQuery}} <i class="fa fa-fw fa-times"></i>
                      </a>
                  </span></th>
              </tr>
            </thead>
            <tbody>
              <tr ng-repeat="message in messages | filter: search">
                <td class="text-nowrap align-middle text-secondary">{{message.date}}</td>
                <td class="text-nowrap align-middle text-secondary">{{message.time}}</td>
                <% if (!hidesource || (login && role == 'admin')) { %>
                  <td class="text-nowrap text-center text-white small font-monospace fw-bolder align-middle d-none d-md-table-cell clickable-td"
                    tabindex="0" popover-content="source" style="background-color: {{message.color || 'grey'}}">
                    {{message.source}}
                  </td>
                <% } %>
                <% if (!hidecapcode || (login && role == 'admin')) { %>
                  <td class="text-nowrap text-center text-white small font-monospace fw-bolder align-middle d-none d-md-table-cell clickable-td"
                    tabindex="0" popover-content="address" style="background-color: {{message.color || 'grey'}}">
                    {{message.address}}
                  </td>
                <% } %>
                <td class="text-nowrap align-middle text-secondary clickable-td"
                  tabindex="0" popover-content="agency">
                  <% if (iconsize == 'small') { %>
                  <span class="fa-stack fa-fw align-middle" style="color: {{message.color || 'grey'}};">
                  <% } else { %>
                  <span class="fa-stack fa-lg fa-fw align-middle" style="color: {{message.color || 'grey'}};">
                  <% } %>
                    <i class="fa fa-circle fa-stack-2x"></i>
                    <i ng-if="message.icon" class="fa fa-{{message.icon}} fa-stack-1x fa-inverse"></i>
                    <i ng-if="!message.icon" class="fa fa-question fa-stack-1x fa-inverse"></i>
                  </span>
                  <strong>{{message.agency || ''}}</strong>
                </td>
                <td class="text-nowrap align-middle text-primary d-none d-md-table-cell clickable-td" ng-if="message.alias"
                  tabindex="0" popover-content="alias">
                  {{message.alias}}
                </td>
                <td class="text-nowrap align-middle text-secondary d-none d-md-table-cell" ng-if="!message.alias"></td>
                <td class="align-middle w-100 text-secondary">
                  <div highlight="message.message" replacement="init.replaceText" class="fw-bold text-break"></div>
                </td>
            </tbody>
          </table>
        </div>

        <div class="row" ng-if="messages.length == 0">
          <div class="text-center">
            <h4>No messages found!</h4>
            <div ng-if="hasQuery"><p>Consider broadening your search terms and try again.</p></div>
            <div ng-if="!hasQuery"><p>Have you loaded any message data yet?</p>
              <p>If you believe you reached this message by error, <a href="https://github.com/pagermon/pagermon/issues"
                                                                      target="_blank">log an issue.</a></p>
            </div>
          </div>
        </div>
        <% if (searchLocation === 'bottom' || typeof searchLocation == 'undefined') { %>
          <%- include ('global/search') -%>
        <% } %>
        <%- include ('global/pagination') -%>

        </div>
      </script>
    </main>

    <%- include ('global/footer') -%>

    <% if (frontPopupEnable) { %>
      <div class="modal fade" id="oneTimeModal" tabindex="-1" aria-labelledby="oneTimeModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-3" id="oneTimeModalLabel">
                <i class="fa fa-exclamation-circle me-1"></i><%= frontPopupTitle %>
              </h1>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <%- frontPopupContent %>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" ng-click="dismissFrontPopup()">Close</button>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </body>
</html>